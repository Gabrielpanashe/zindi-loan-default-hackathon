__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.egg-info/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

